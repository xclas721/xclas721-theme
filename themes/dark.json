{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#002b36",
    "--foreground": "#e9f3f4",
    "--editor-surface": "#002b36",
    "--card": "#06343f",
    "--card-foreground": "#e9f3f4",
    "--popover": "#0b3e4b",
    "--popover-foreground": "#e9f3f4",
    "--primary": "#19f9d8",
    "--primary-foreground": "#002b36",
    "--secondary": "#114957",
    "--secondary-foreground": "#e9f3f4",
    "--muted": "#06343f",
    "--muted-foreground": "#b0c4c8",
    "--accent": "#0f4756",
    "--accent-foreground": "#f2f6f6",
    "--border": "#002b36",
    "--input": "#3d7380",
    "--ring": "#19f9d8",
    "--chart-1": "#19f9d8",
    "--chart-2": "#09cbdd",
    "--chart-3": "#ffcc95",
    "--chart-4": "#f48fb1",
    "--chart-5": "#ff4f84",
    "--sidebar": "#002b36",
    "--sidebar-foreground": "#d3dfe1",
    "--sidebar-primary": "#19f9d8",
    "--sidebar-primary-foreground": "#002b36",
    "--sidebar-accent": "#0b3e4b",
    "--sidebar-accent-foreground": "#f2f6f6",
    "--sidebar-border": "#002b36",
    "--sidebar-ring": "#19f9d8",
    "--worktree-sidebar": "#002b36",
    "--worktree-sidebar-foreground": "#d3dfe1",
    "--worktree-sidebar-accent": "#0b3e4b",
    "--worktree-sidebar-accent-foreground": "#f2f6f6",
    "--worktree-sidebar-border": "#002b36",
    "--worktree-sidebar-ring": "#19f9d8",
    "--worktree-sidebar-active": "#0d4a55",
    "--worktree-sidebar-active-border": "#178f80",
    "--host-badge": "#0f4756",
    "--host-badge-foreground": "#a1d7da",
    "--tab-bar": "#002b36",
    "--tab-active": "#002b36",
    "--tab-active-foreground": "#eaf7f8",
    "--tab-active-indicator": "#19f9d8",
    "--tab-inactive": "#002b36",
    "--tab-inactive-foreground": "#a5b9bd",
    "--split-divider": "#002b36",
    "--split-divider-hover": "#19f9d8",
    "--chat-user-message": "#124a58",
    "--chat-bold-foreground": "#ffffff",
    "--chat-muted-foreground": "#a5b9bd",
    "--chat-inline-code": "#114957",
    "--chat-inline-code-foreground": "#ffcc95",
    "--chat-code-block": "#002b36",
    "--chat-selection": "#12616f",
    "--chat-selection-foreground": "#ffffff",
    "--text-link": "#2cc5da",
    "--diff-added": "#19f9d8",
    "--diff-removed": "#ff4f84",
    "--git-decoration-added": "#19f9d8",
    "--git-decoration-modified": "#ffcc95",
    "--git-decoration-deleted": "#ff5c8a",
    "--git-decoration-renamed": "#09cbdd",
    "--git-decoration-untracked": "#7fe3a8",
    "--git-decoration-copied": "#a1d7da",
    "--git-decoration-ignored": "#7f999f"
  },
  "tokenColors": [
    {"name": "Comments", "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": {"foreground": "#84979c", "fontStyle": "italic"}},
    {"name": "Declarations, imports and modifiers", "scope": ["keyword", "keyword.other", "storage", "storage.type", "storage.modifier", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.default", "keyword.other.import", "keyword.other.package", "keyword.other.using", "keyword.other.use", "keyword.operator.new", "keyword.operator.expression", "keyword.other.important"], "settings": {"foreground": "#ff2c6d"}},
    {"name": "Control flow", "scope": ["keyword.control", "keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.trycatch"], "settings": {"foreground": "#f48fb1"}},
    {"name": "Operators", "scope": ["keyword.operator", "punctuation.definition.template-expression", "punctuation.section.embedded", "punctuation.separator.key-value"], "settings": {"foreground": "#ffcc95"}},
    {"name": "Punctuation", "scope": ["punctuation", "meta.brace", "punctuation.definition.tag", "punctuation.terminator", "punctuation.separator", "punctuation.accessor"], "settings": {"foreground": "#c5c5c5"}},
    {"name": "Strings", "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string", "string.unquoted"], "settings": {"foreground": "#00acc1"}},
    {"name": "Escapes and regular expressions", "scope": ["constant.character.escape", "constant.other.placeholder", "string.regexp", "constant.other.character-class.regexp"], "settings": {"foreground": "#eb9485"}},
    {"name": "Numbers and language constants", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined", "keyword.other.unit", "support.constant"], "settings": {"foreground": "#ff5622"}},
    {"name": "Named constants", "scope": ["constant", "constant.other", "variable.other.constant", "variable.other.enummember", "entity.name.constant"], "settings": {"foreground": "#ffcc95"}},
    {"name": "Functions and methods", "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function", "entity.name.method", "meta.function-call.generic"], "settings": {"foreground": "#09cbdd"}},
    {"name": "Variables, properties and keys", "scope": ["variable", "variable.other", "variable.other.property", "variable.other.object.property", "variable.other.member", "meta.object-literal.key", "support.variable", "support.variable.property", "support.type.property-name", "entity.name.tag.yaml", "meta.property-name"], "settings": {"foreground": "#a1d7da"}},
    {"name": "Parameters", "scope": ["variable.parameter", "meta.parameter", "entity.name.variable.parameter"], "settings": {"foreground": "#f48fb1"}},
    {"name": "this, self and super", "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"], "settings": {"foreground": "#f48fb1", "fontStyle": "italic"}},
    {"name": "Types, classes and interfaces", "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.struct", "entity.name.interface", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "storage.type.built-in", "storage.type.annotation", "meta.type.annotation"], "settings": {"foreground": "#64ffdb"}},
    {"name": "Decorators and annotations", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "punctuation.definition.annotation", "storage.type.annotation.java", "keyword.other.special-method.dockerfile"], "settings": {"foreground": "#19f9d8", "fontStyle": "italic"}},
    {"name": "Tags", "scope": ["entity.name.tag", "meta.tag.sgml", "entity.name.tag.css"], "settings": {"foreground": "#ff2c6d"}},
    {"name": "Components", "scope": ["support.class.component", "entity.name.tag.custom"], "settings": {"foreground": "#64ffdb"}},
    {"name": "Attributes", "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "entity.other.attribute-name.jsx"], "settings": {"foreground": "#ffcc95"}},
    {"name": "CSS selectors", "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css", "entity.other.attribute-name.parent-selector"], "settings": {"foreground": "#64ffdb"}},
    {"name": "CSS values", "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color", "support.constant.font-name", "variable.scss", "variable.other.less", "variable.css"], "settings": {"foreground": "#a7deec"}},
    {"name": "Markdown headings", "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"], "settings": {"foreground": "#ffcc95", "fontStyle": "bold"}},
    {"name": "Markdown bold", "scope": "markup.bold", "settings": {"foreground": "#f2f6f6", "fontStyle": "bold"}},
    {"name": "Markdown italic", "scope": "markup.italic", "settings": {"fontStyle": "italic"}},
    {"name": "Markdown strikethrough", "scope": "markup.strikethrough", "settings": {"fontStyle": "strikethrough"}},
    {"name": "Markdown quotes", "scope": "markup.quote", "settings": {"foreground": "#9fb3b8", "fontStyle": "italic"}},
    {"name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": {"foreground": "#a7deec"}},
    {"name": "Markdown links", "scope": ["markup.underline.link", "string.other.link", "meta.link"], "settings": {"foreground": "#2cc5da", "fontStyle": "underline"}},
    {"name": "Markdown list markers and rules", "scope": ["punctuation.definition.list", "markup.list.numbered", "meta.separator"], "settings": {"foreground": "#ff2c6d"}},
    {"name": "Inserted", "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"], "settings": {"foreground": "#19f9d8"}},
    {"name": "Deleted", "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"], "settings": {"foreground": "#ff4f84"}},
    {"name": "Changed", "scope": ["markup.changed", "meta.diff.range", "meta.diff.header"], "settings": {"foreground": "#ffcc95"}},
    {"name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": {"foreground": "#ff4f84", "fontStyle": "underline"}},
    {"name": "Deprecated", "scope": "invalid.deprecated", "settings": {"foreground": "#9fb3b8", "fontStyle": "strikethrough"}}
  ]
}
